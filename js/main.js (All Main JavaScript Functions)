// Background Dot Canvas Particles
const canvas = document.getElementById('dotCanvas');
const ctx = canvas.getContext('2d');
function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
resizeCanvas();
window.addEventListener('resize', resizeCanvas);

class Particle {
    constructor() {
        this.x = Math.random() * canvas.width;
        this.y = Math.random() * canvas.height;
        this.size = Math.random() * 2 + 1;
        this.speedX = (Math.random() - 0.5) * 0.8;
        this.speedY = (Math.random() - 0.5) * 0.8;
    }
    draw() {
        ctx.fillStyle = 'rgba(56, 189, 248, 0.6)';
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fill();
    }
    update() {
        this.x += this.speedX;
        this.y += this.speedY;
        if (this.x < 0 || this.x > canvas.width) this.speedX *= -1;
        if (this.y < 0 || this.y > canvas.height) this.speedY *= -1;
    }
}

const particleArray = Array.from({ length: 45 }, () => new Particle());
function animateCanvas() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    particleArray.forEach(p => { p.draw(); p.update(); });
    requestAnimationFrame(animateCanvas);
}
animateCanvas();

/* --- GST TOOL JAVASCRIPT --- */
function readExcelFile(file) {
    return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = (e) => {
            try {
                const data = new Uint8Array(e.target.result);
                const workbook = XLSX.read(data, { type: 'array' });
                const firstSheetName = workbook.SheetNames[0];
                const worksheet = workbook.Sheets[firstSheetName];
                const jsonData = XLSX.utils.sheet_to_json(worksheet, { defval: "" });
                resolve(jsonData);
            } catch (error) {
                reject(error);
            }
        };
        reader.onerror = (error) => reject(error);
        reader.readAsArrayBuffer(file);
    });
}

function downloadFile(content, fileName, contentType) {
    const blob = new Blob([content], { type: contentType });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = fileName;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
}

async function generateGSTJSON() {
    const fileInput = document.getElementById('excelUpload');
    if (!fileInput.files[0]) {
        alert("Please upload the sales record file first!");
        return;
    }

    try {
        const rows = await readExcelFile(fileInput.files[0]);
        let b2bData = [];
        let b2csData = [];

        rows.forEach(row => {
            const gstin = row['GSTIN'] || row['Customer GSTIN'] || '';
            const invNo = row['Invoice Number'] || row['Invoice No'] || '';
            const invDate = row['Invoice Date'] || '';
            const totalVal = parseFloat(row['Total Amount'] || row['Invoice Value'] || 0);
            const taxableVal = parseFloat(row['Taxable Value'] || 0);
            const rate = parseFloat(row['GST Rate'] || 18);

            if (gstin.trim() !== '') {
                b2bData.push({
                    "ctin": gstin,
                    "inv": [{
                        "inum": invNo,
                        "idt": invDate,
                        "val": totalVal,
                        "itms": [{
                            "num": 1,
                            "itm_det": {
                                "txval": taxableVal,
                                "rt": rate
                            }
                        }]
                    }]
                });
            } else {
                b2csData.push({
                    "sply_ty": "INTRA",
                    "rt": rate,
                    "txval": taxableVal
                });
            }
        });

        const gstJSONObject = {
            "gstin": "33AAAAA0000A1Z5",
            "fp": "032026",
            "b2b": b2bData,
            "b2cs": b2csData
        };

        const jsonString = JSON.stringify(gstJSONObject, null, 2);
        downloadFile(jsonString, "GSTR1_Sales_Data.json", "application/json");

    } catch (err) {
        alert("Error processing Excel file: " + err.message);
    }
}

async function exportForAccounting() {
    const fileInput = document.getElementById('excelUpload');
    if (!fileInput.files[0]) {
        alert("Please upload the sales record file first!");
        return;
    }

    try {
        const rows = await readExcelFile(fileInput.files[0]);
        let csvRows = [];
        csvRows.push([
            "Invoice Date", "Invoice Number", "Customer Name", "GSTIN", "Taxable Value", "CGST", "SGST", "IGST", "Total Amount"
        ].join(","));

        rows.forEach(row => {
            const date = row['Invoice Date'] || '';
            const invNo = row['Invoice Number'] || row['Invoice No'] || '';
            name = row['Customer Name'] || 'Cash Sale';
            const gstin = row['GSTIN'] || row['Customer GSTIN'] || '';
            const taxable = parseFloat(row['Taxable Value'] || 0);
            const rate = parseFloat(row['GST Rate'] || 18);
            
            const taxAmount = (taxable * rate) / 100;
            const cgst = gstin.startsWith("33") ? taxAmount / 2 : 0;
            const sgst = gstin.startsWith("33") ? taxAmount / 2 : 0;
            const igst = !gstin.startsWith("33") ? taxAmount : 0;
            const total = taxable + taxAmount;

            csvRows.push([
                `"${date}"`, `"${invNo}"`, `"${name}"`, `"${gstin}"`,
                taxable.toFixed(2), cgst.toFixed(2), sgst.toFixed(2), igst.toFixed(2), total.toFixed(2)
            ].join(","));
        });

        const csvContent = csvRows.join("\n");
        downloadFile(csvContent, "Accounting_Import_Ready.csv", "text/csv");

    } catch (err) {
        alert("Error exporting CSV: " + err.message);
    }
}
