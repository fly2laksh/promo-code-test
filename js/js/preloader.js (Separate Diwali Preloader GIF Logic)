// Preloader GIF Animation Logic (Diwali Special)
window.addEventListener('load', function() {
    setTimeout(function() {
        const preloader = document.getElementById('preloader');
        if(preloader) {
            preloader.style.opacity = '0'; // Smooth fade out start
            
            // Fade out complete hone ke baad element remove kar dena
            setTimeout(function() {
                preloader.style.display = 'none';
            }, 800); // 0.8 seconds wait karega fade effect ke liye
        }
    }, 3000); // 3 seconds wait time before fading
});
